# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
WEBHOOK_EVENT_LOG_PATH=.runtime/webhook-events.jsonl
INBOUND_IDLE_BUFFER_MS=5000

# Runtime selection. New work defaults to the internal MCP.
# Set legacy_twilio only for compatibility or rollback.
WHATSAPP_PROVIDER=internal_mcp
WHATSAPP_MCP_RESOURCE_URL=http://localhost:3000
WHATSAPP_MCP_AUTHORIZATION_SERVER=https://auth.automatedandco.danienremoto.com

# Cloudflare WhatsApp MCP closed-pilot configuration.
# Put secret values in Wrangler secrets, never in this file or Git.
PUBLIC_ORIGIN=https://automated-co-whatsapp-mcp.<workers-subdomain>.workers.dev
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_EMBEDDED_SIGNUP_SESSION_VERSION=4
META_WEBHOOK_VERIFY_TOKEN=
CONVERSATION_REF_SECRET=
INSTALLATION_ENCRYPTION_KEY=
PILOT_ADMIN_TOKEN=
OAUTH_SIGNING_KEY_ID=
OAUTH_SIGNING_PRIVATE_JWK=
OAUTH_SIGNING_PUBLIC_JWK=
OAUTH_CLIENT_ID=https://chatgpt.com/oauth/client.json
OAUTH_REDIRECT_URI=https://chatgpt.com/connector_platform_oauth_redirect

# Legacy Twilio WhatsApp webhook configuration.
# Required only when WHATSAPP_PROVIDER=legacy_twilio or the legacy script is used.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_ADMIN_REVIEW_TO=whatsapp:+573006211340
TWILIO_WEBHOOK_PUBLIC_URL=

# Inventory access is intentionally abstracted.
# TODO: Keep this provider read-only. Do not add write scopes.
INVENTORY_PROVIDER=mock_grocery

# Agent decision engine.
# deterministic = in-process grounded fallback
# local_cli = send JSON to AGENT_LOCAL_CLI_COMMAND over stdin and expect JSON decision on stdout
AGENT_DECISION_MODE=deterministic
AGENT_LOCAL_CLI_COMMAND=npm run -s agent:codex
AGENT_LOCAL_CLI_TIMEOUT_MS=120000
AGENT_PROMPT_PATH=prompts/local-codex-agent.md
CODEX_CLI_PATH=

# Existing Shopify access should be supplied by the environment/plugin later.
# TODO: Do not scaffold a new Shopify custom app here.
SHOPIFY_STORE_DOMAIN=
