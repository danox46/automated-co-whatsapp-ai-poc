# Server
WEBHOOK_PORT=3000
OPERATOR_PORT=3100
OPERATOR_HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=debug
WEBHOOK_EVENT_LOG_PATH=.runtime/webhook-events.jsonl
OPERATOR_DATABASE_PATH=.runtime/operator-inbox.sqlite
OPERATOR_MEDIA_PATH=.runtime/media
OPERATOR_SETTINGS_PATH=.runtime/operator-settings.json
OPERATOR_DEMO_MODE=false
INBOUND_IDLE_BUFFER_MS=5000

# Twilio WhatsApp webhook configuration.
# TODO: Fill these once Twilio sandbox/WhatsApp sender is configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_ADMIN_REVIEW_TO=whatsapp:+573006211340
TWILIO_WEBHOOK_PUBLIC_URL=

# Inventory access is intentionally abstracted.
# TODO: Keep this provider read-only. Do not add write scopes.
INVENTORY_PROVIDER=mock_grocery

# Agent decision engine.
# deterministic = in-process grounded fallback
# local_cli = send JSON to AGENT_LOCAL_CLI_COMMAND over stdin and expect JSON decision on stdout
AGENT_DECISION_MODE=deterministic
AGENT_LOCAL_CLI_COMMAND=npm run -s agent:codex
AGENT_LOCAL_CLI_TIMEOUT_MS=120000
AGENT_PROMPT_PATH=prompts/local-codex-agent.md
CODEX_CLI_PATH=

# Existing Shopify access should be supplied by the environment/plugin later.
# TODO: Do not scaffold a new Shopify custom app here.
SHOPIFY_STORE_DOMAIN=
