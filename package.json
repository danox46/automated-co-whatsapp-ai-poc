{
  "name": "automated-co-whatsapp-ai-poc",
  "version": "0.3.0",
  "private": true,
  "description": "Policy-enforced WhatsApp MCP server with durable structured conversation history, signed Meta webhook, and legacy Twilio advisor POC.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:mcp": "tsx watch src/server.ts",
    "dev:legacy:twilio": "tsx watch src/legacy/twilioServer.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "start": "node dist/server.js",
    "start:mcp": "node dist/server.js",
    "start:legacy:twilio": "node dist/legacy/twilioServer.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "check:env": "tsx src/local/checkEnv.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "agent:mock": "tsx src/local/mockAgentCli.ts",
    "agent:codex": "tsx src/local/codexAgentCli.ts",
    "demo": "tsx src/local/demo.ts",
    "test:mcp-policy": "vitest run src/mcp",
    "test:meta-webhook": "vitest run src/meta/webhook.test.ts",
    "verify:mcp": "npm run typecheck && npm run test:mcp-policy && npm run test:meta-webhook && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "cloudflared": "^0.7.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
